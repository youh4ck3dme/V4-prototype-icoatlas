# ICO Atlas V4 - Environment Configuration Template
# ⚠️ SECURITY WARNING: Never commit .env file to git!
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Option 1: SQLite (Default - Development only)
DATABASE_URL=sqlite:///./sql_app.db

# Option 2: PostgreSQL (REQUIRED for production)
# DATABASE_URL=postgresql://username:STRONG_PASSWORD_HERE@localhost:5432/iluminati_db

# ============================================
# SECURITY (CRITICAL - CHANGE IN PRODUCTION!)
# ============================================
# Generate a secure secret key: openssl rand -hex 32
# ⚠️ NEVER use default value in production!
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Webhook signature secret (for HMAC verification)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# JWT token expiration in minutes (default: 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# CORS ORIGINS (CRITICAL for production!)
# ============================================
# JSON array of allowed origins
# ⚠️ NEVER use "*" in production!
# Development:
CORS_ORIGINS=["http://localhost:8009", "http://localhost:8010", "http://localhost:5173", "http://localhost:3000"]
# Production example:
# CORS_ORIGINS=["https://yourdomain.com", "https://app.yourdomain.com"]

# ============================================
# RATE LIMITING
# ============================================
# Default rate limit (requests per minute)
RATE_LIMIT_DEFAULT=60

# Tier-based rate limits
RATE_LIMIT_FREE=10
RATE_LIMIT_BASIC=50
RATE_LIMIT_PRO=200
RATE_LIMIT_ENTERPRISE=1000

# ============================================
# ENVIRONMENT
# ============================================
# Options: development, staging, production
# ⚠️ Set to "production" to enable HTTPS redirect
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# REDIS CONFIGURATION (Optional but recommended)
# ============================================
# REDIS_URL=redis://localhost:6379/0

# ============================================
# EXTERNAL API KEYS (Optional)
# ============================================
# Hungary - NAV API (requires registration)
# HU_NAV_API_KEY=your-nav-api-key-here

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=http://localhost:8000
VITE_ENABLE_PWA=true
