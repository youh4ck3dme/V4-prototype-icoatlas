{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Poland Company Data Template",
  "description": "Standardized JSON template for Polish company data from KRS, CEIDG, and GUS",
  "type": "object",
  "properties": {
    "nip": {
      "type": "string",
      "description": "10-digit Polish tax identification number (NIP)",
      "pattern": "^[0-9]{10}$",
      "example": "5260250995"
    },
    "krs": {
      "type": "string",
      "description": "KRS number for companies (Krajowy Rejestr Sądowy)",
      "pattern": "^[0-9]{10}$",
      "example": "0000021784"
    },
    "regon": {
      "type": "string",
      "description": "REGON statistical number",
      "pattern": "^[0-9]{9}$",
      "example": "012100784"
    },
    "country": {
      "type": "string",
      "const": "PL",
      "description": "Country code for Poland"
    },
    "name": {
      "type": "string",
      "description": "Official company name (Nazwa)",
      "example": "CD PROJEKT SPÓŁKA AKCYJNA"
    },
    "legal_form": {
      "type": "string",
      "description": "Legal form of the company (Forma prawna)",
      "example": "Spółka akcyjna"
    },
    "address": {
      "type": "string",
      "description": "Full registered address (Siedziba)",
      "example": "ul. Jagiellońska 74, 03-301 Warszawa"
    },
    "street": {
      "type": "string",
      "description": "Street name and number",
      "example": "ul. Jagiellońska 74"
    },
    "city": {
      "type": "string",
      "description": "City name (Miasto)",
      "example": "Warszawa"
    },
    "zip": {
      "type": "string",
      "description": "Postal code (Kod pocztowy)",
      "pattern": "^[0-9]{2}-[0-9]{3}$",
      "example": "03-301"
    },
    "postal_code": {
      "type": "string",
      "description": "Postal code (alias for zip)",
      "pattern": "^[0-9]{2}-[0-9]{3}$",
      "example": "03-301"
    },
    "voivodeship": {
      "type": "string",
      "description": "Voivodeship (Województwo)",
      "example": "mazowieckie"
    },
    "district": {
      "type": "string",
      "description": "District (Powiat)",
      "example": "Warszawa"
    },
    "registration_id": {
      "type": "string",
      "description": "KRS registration number",
      "example": "0000021784"
    },
    "registration_section": {
      "type": "string",
      "description": "Registration section",
      "example": "B"
    },
    "registration_source": {
      "type": "string",
      "enum": ["KRS", "CEIDG", "GUS"],
      "description": "Source register of the data"
    },
    "registration_court": {
      "type": "string",
      "description": "Registration court (Sąd rejestrowy)",
      "example": "Sąd Rejonowy dla m.st. Warszawy w Warszawie, XII Wydział Gospodarczy Krajowego Rejestru Sądowego"
    },
    "capital": {
      "type": "string",
      "description": "Share capital (Kapitał zakładowy)",
      "example": "100 000 000,00 zł"
    },
    "executives": {
      "type": "array",
      "description": "List of board members (Zarząd)",
      "items": {
        "type": "string"
      },
      "example": [
        "Adam Kiciński - Prezes Zarządu",
        "Piotr Nielubowicz - Członek Zarządu"
      ]
    },
    "shareholders": {
      "type": "array",
      "description": "List of shareholders (Wspólnicy/Akcjonariusze)",
      "items": {
        "type": "string"
      },
      "example": []
    },
    "founded": {
      "type": "string",
      "format": "date",
      "description": "Date of registration (Data rejestracji)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "example": "1994-05-27"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktywna",
        "W likwidacji",
        "W upadłości",
        "Wykreślona",
        "Zawieszona"
      ],
      "description": "Company status",
      "example": "Aktywna"
    },
    "pkd_code": {
      "type": "string",
      "description": "Primary PKD economic activity code",
      "example": "58.21.Z"
    },
    "pkd_description": {
      "type": "string",
      "description": "Description of primary economic activity",
      "example": "Wydawanie gier komputerowych"
    },
    "vat_registered": {
      "type": "boolean",
      "description": "Whether company is VAT registered",
      "example": true
    },
    "white_list_vat": {
      "type": "boolean",
      "description": "Whether company is on VAT white list (Biała lista VAT)",
      "example": true
    },
    "bank_accounts": {
      "type": "array",
      "description": "Registered bank accounts from white list",
      "items": {
        "type": "string"
      },
      "example": ["PL12345678901234567890123456"]
    },
    "financial_data": {
      "type": "object",
      "description": "Financial indicators",
      "properties": {
        "year": {
          "type": "integer",
          "description": "Reporting year",
          "example": 2023
        },
        "revenue": {
          "type": "number",
          "description": "Revenue in PLN",
          "example": 2800000000
        },
        "profit": {
          "type": "number",
          "description": "Net profit in PLN",
          "example": 850000000
        },
        "assets": {
          "type": "number",
          "description": "Total assets in PLN",
          "example": 4200000000
        },
        "employees": {
          "type": "integer",
          "description": "Number of employees",
          "example": 1100
        }
      }
    },
    "risk_score": {
      "type": "number",
      "description": "Calculated risk score (0-100)",
      "minimum": 0,
      "maximum": 100,
      "example": 15
    }
  },
  "required": ["nip", "country", "name"],
  "additionalProperties": false
}
