# ============================================================
# V4 ICO Atlas – Production Environment Variables Template
# ============================================================
# Copy this file to .env.production and fill in all values.
#
#   cp .env.production.example .env.production
#   nano .env.production          # fill in secrets
#
# NEVER commit .env.production to git.
# ============================================================


# ── Database ──────────────────────────────────────────────
# PostgreSQL credentials used by both docker-compose and the backend.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32
POSTGRES_DB=iluminati

# Full async URL consumed by SQLAlchemy (automatically assembled in
# docker-compose.prod.yml; override here only when using an external DB).
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db:5432/iluminati


# ── Redis ─────────────────────────────────────────────────
# Leave as-is when redis runs inside Docker Compose.
# Override when using an external Redis (e.g. Redis Cloud).
# REDIS_URL=redis://redis:6379/0


# ── Application ───────────────────────────────────────────
ENV=production
LOG_LEVEL=INFO

# Gunicorn worker count (default: 2; rule of thumb: 2 × CPU cores + 1)
WORKERS=2

# Generate with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# JWT token lifetime in minutes (default 24 h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowed origins.
# Use your actual domain(s) in production – never "*".
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# If you have no domain yet (bare IP), use:
# CORS_ORIGINS=http://194.182.87.6


# ── Frontend (Vite build-time vars) ───────────────────────
# With nginx reverse proxy on the same host /api is enough.
VITE_API_URL=/api
VITE_ENVIRONMENT=production
VITE_ENABLE_PWA=true


# ── Monitoring (optional) ─────────────────────────────────
# Sentry – leave empty to disable error tracking
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Frontend Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Grafana admin password (used by docker-compose.monitoring.yml)
GRAFANA_PASSWORD=CHANGE_ME_grafana_admin_password


# ── Feature flags ─────────────────────────────────────────
ENABLE_ANALYTICS=true
ENABLE_WEBHOOKS=true
ENABLE_ERP_INTEGRATIONS=true


# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_FREE=10
RATE_LIMIT_BASIC=50
RATE_LIMIT_PRO=200
RATE_LIMIT_ENTERPRISE=1000


# ── External API keys (optional) ──────────────────────────
# Hungary NAV (requires registration at nav.gov.hu)
# HU_NAV_API_KEY=

# Proxy list for web scraping (comma-separated)
# PROXY_LIST=http://proxy1:port,http://proxy2:port
