# ICO Atlas V4 - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Option 1: SQLite (Default - No setup required)
DATABASE_URL=sqlite:///./sql_app.db

# Option 2: PostgreSQL (Recommended for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/iluminati_db

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# If Redis is not available, in-memory cache will be used
# REDIS_URL=redis://localhost:6379/0

# ============================================
# SECURITY
# ============================================
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT token expiration in minutes (default: 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# CORS ORIGINS
# ============================================
# Allowed origins for CORS (frontend URLs)
CORS_ORIGINS=["http://localhost:8009", "http://localhost:8010", "http://localhost:5173", "http://localhost:3000"]

# ============================================
# EXTERNAL API KEYS (Optional)
# ============================================
# These are optional - the app works without them using web scraping

# Czech Republic - ARES API (no key required - public API)
# ARES_API_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/ekonomicke-subjekty

# Poland - KRS API (no key required - public API)
# KRS_API_URL=https://api-krs.ms.gov.pl/api/krs

# Hungary - NAV API (requires registration)
# HU_NAV_API_KEY=your-nav-api-key-here
# HU_NAV_API_URL=https://api.onlineszamla.nav.gov.hu

# Slovakia - RPO API (no key required - public API)
# RPO_API_URL=https://rpo.statistics.sk/api

# ============================================
# PROXY CONFIGURATION (Optional)
# ============================================
# Comma-separated list of proxy URLs for web scraping
# PROXY_LIST=http://proxy1:port,http://proxy2:port

# ============================================
# APPLICATION SETTINGS
# ============================================
# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable/disable features
ENABLE_ANALYTICS=true
ENABLE_WEBHOOKS=true
ENABLE_ERP_INTEGRATIONS=true

# ============================================
# RATE LIMITING
# ============================================
# Requests per minute for different tiers
RATE_LIMIT_FREE=10
RATE_LIMIT_BASIC=50
RATE_LIMIT_PRO=200
RATE_LIMIT_ENTERPRISE=1000

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Backend API URL (for frontend)
VITE_API_URL=http://localhost:8000

# Enable PWA (Progressive Web App)
VITE_ENABLE_PWA=true
