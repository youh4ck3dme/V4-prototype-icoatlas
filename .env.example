PUBLIC_APP_DOMAIN=icoatlas.example.com
PUBLIC_API_DOMAIN=api.icoatlas.example.com
PUBLIC_API_URL=https://api.icoatlas.example.com

ENVIRONMENT=production
LOG_LEVEL=info

# Optional provider/API secrets
ICOATLAS_API_KEY=change_me
SENTRY_DSN=

# Finančná správa SR OpenData (IBAN overenie, ds_dph_iban). Bezplatný kľúč: https://opendata.financnasprava.sk/
FS_OPENDATA_API_KEY=
# Testovacie dáta bez volania externých registrov (1 = zapnuté)
RUZ_STUB_MODE=0
FS_IBAN_STUB_MODE=0

# JWT podpis prihlásenia (povinný v produkcii, aspoň 32 náhodných znakov, napr. python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
