{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Slovakia Company Data Template",
  "description": "Standardized JSON template for Slovak company data from ORSR, RUZ, ZRSR, RPO",
  "type": "object",
  "properties": {
    "ico": {
      "type": "string",
      "description": "8-digit Slovak company registration number (IČO)",
      "pattern": "^[0-9]{8}$",
      "example": "36421928"
    },
    "country": {
      "type": "string",
      "const": "SK",
      "description": "Country code for Slovakia"
    },
    "name": {
      "type": "string",
      "description": "Official company name (Obchodné meno)",
      "example": "ESET, spol. s r.o."
    },
    "legal_form": {
      "type": "string",
      "description": "Legal form of the company (Právna forma)",
      "example": "Spoločnosť s ručením obmedzeným"
    },
    "address": {
      "type": "string",
      "description": "Full registered address (Sídlo)",
      "example": "Einsteinova 24, 851 01 Bratislava"
    },
    "street": {
      "type": "string",
      "description": "Street name and number",
      "example": "Einsteinova 24"
    },
    "city": {
      "type": "string",
      "description": "City name (Mesto)",
      "example": "Bratislava"
    },
    "zip": {
      "type": "string",
      "description": "Postal code (PSČ)",
      "pattern": "^[0-9]{3}\\s?[0-9]{2}$",
      "example": "851 01"
    },
    "postal_code": {
      "type": "string",
      "description": "Postal code (alias for zip)",
      "pattern": "^[0-9]{3}\\s?[0-9]{2}$",
      "example": "851 01"
    },
    "district": {
      "type": "string",
      "description": "District (Okres)",
      "example": "Bratislava I"
    },
    "region": {
      "type": "string",
      "description": "Region (Kraj)",
      "example": "Bratislavský kraj"
    },
    "dic": {
      "type": "string",
      "description": "Tax identification number (DIČ)",
      "pattern": "^[0-9]{10}$",
      "example": "2020372643"
    },
    "ic_dph": {
      "type": "string",
      "description": "VAT number (IČ DPH)",
      "pattern": "^SK[0-9]{10}$",
      "example": "SK2020372643"
    },
    "registration_id": {
      "type": "string",
      "description": "Registration insert number (Vložka číslo)",
      "example": "4156/B"
    },
    "registration_section": {
      "type": "string",
      "description": "Registration section (Oddiel)",
      "example": "Sro"
    },
    "registration_source": {
      "type": "string",
      "enum": ["ORSR", "RUZ", "ZRSR", "RPO"],
      "description": "Source register of the data"
    },
    "capital": {
      "type": "string",
      "description": "Share capital (Základné imanie)",
      "example": "6 638,78 €"
    },
    "executives": {
      "type": "array",
      "description": "List of statutory representatives (Štatutárny orgán)",
      "items": {
        "type": "string"
      },
      "example": ["Ing. Richard Marko", "Miroslav Trnka"]
    },
    "shareholders": {
      "type": "array",
      "description": "List of shareholders/partners (Spoločníci)",
      "items": {
        "type": "string"
      },
      "example": ["ESET Holding a.s."]
    },
    "founded": {
      "type": "string",
      "format": "date",
      "description": "Date of registration (Deň zápisu)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "example": "1992-04-15"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktívna",
        "Likvidácia",
        "Konkurz",
        "Likvidácia/Konkurz",
        "Vymazaná"
      ],
      "description": "Company status",
      "example": "Aktívna"
    },
    "financial_data": {
      "type": "object",
      "description": "Financial indicators from RUZ",
      "properties": {
        "year": {
          "type": "integer",
          "description": "Reporting year",
          "example": 2023
        },
        "revenue": {
          "type": "number",
          "description": "Revenue in EUR",
          "example": 125000000
        },
        "profit": {
          "type": "number",
          "description": "Net profit in EUR",
          "example": 15000000
        },
        "assets": {
          "type": "number",
          "description": "Total assets in EUR",
          "example": 80000000
        },
        "liabilities": {
          "type": "number",
          "description": "Total liabilities in EUR",
          "example": 30000000
        },
        "equity": {
          "type": "number",
          "description": "Equity in EUR",
          "example": 50000000
        },
        "employees": {
          "type": "integer",
          "description": "Number of employees",
          "example": 450
        }
      }
    },
    "beneficial_owners": {
      "type": "array",
      "description": "Beneficial owners from RPO register",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of beneficial owner"
          },
          "birth_date": {
            "type": "string",
            "format": "date",
            "description": "Date of birth"
          },
          "nationality": {
            "type": "string",
            "description": "Nationality"
          },
          "ownership_percentage": {
            "type": "number",
            "description": "Ownership percentage"
          }
        }
      }
    },
    "risk_score": {
      "type": "number",
      "description": "Calculated risk score (0-100)",
      "minimum": 0,
      "maximum": 100,
      "example": 25
    }
  },
  "required": ["ico", "country", "name"],
  "additionalProperties": false
}
